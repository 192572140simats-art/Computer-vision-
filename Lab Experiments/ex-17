
import cv2

# Read the original image
img = cv2.imread("image.jpg")

if img is None:
    print("Image not found")
else:
    # Copy the original image
    watermarked = img.copy()

    # Watermark text
    text = "WATERMARK"

    # Set font properties
    font = cv2.FONT_HERSHEY_SIMPLEX
    font_scale = 1.5
    color = (255, 255, 255)
    thickness = 3

    # Get image dimensions
    height, width = img.shape[:2]

    # Set watermark position
    position = (width - 300, height - 30)

    # Insert watermark text
    cv2.putText(
        watermarked,
        text,
        position,
        font,
        font_scale,
        color,
        thickness,
        cv2.LINE_AA
    )

    # Display original and watermarked images
    cv2.imshow("Original Image", img)
    cv2.imshow("Watermarked Image", watermarked)

    # Save the watermarked image
    cv2.imwrite("watermarked_image.jpg", watermarked)

    print("Watermark inserted successfully")
    print("Saved as watermarked_image.jpg")

    cv2.waitKey(0)
    cv2.destroyAllWindows()
